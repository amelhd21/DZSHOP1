# Identifiant Google (le MÊME que GOOGLE_CLIENT_ID de l'API)
VITE_GOOGLE_CLIENT_ID=ton-identifiant.apps.googleusercontent.com

# Adresse de l'API. En local : ne mets RIEN (http://localhost:5000 par défaut).
